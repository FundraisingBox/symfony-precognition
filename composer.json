{
    "name": "fundraisingbox/symfony-precognition",
    "description": "A symfony bundle that allows validating requests without executing controller code",
    "license": "MIT",
    "type": "symfony-bundle",
    "require": {
        "php": ">=8.3",
        "symfony/config": "^6.4 || ^7.0 || ^8.0",
        "symfony/dependency-injection": "^6.4 || ^7.0 || ^8.0",
        "symfony/event-dispatcher": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-foundation": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-kernel": "^6.4 || ^7.0 || ^8.0",
        "symfony/validator": "^6.4 || ^7.0 || ^8.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.75",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5",
        "symfony/browser-kit": "^6.4 || ^7.0 || ^8.0",
        "symfony/framework-bundle": "^6.4 || ^7.0 || ^8.0",
        "symfony/property-access": "^6.4 || ^7.0 || ^8.0",
        "symfony/property-info": "^6.4 || ^7.0 || ^8.0",
        "symfony/serializer": "^6.4 || ^7.0 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "FundraisingBox\\Precognition\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FundraisingBox\\Precognition\\Tests\\": "tests/"
        }
    }
}
